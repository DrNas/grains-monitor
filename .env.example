# Names only. The real values are repository secrets (Settings -> Secrets and variables -> Actions)
# and are never committed. For a local build, export these in your shell first.
MMN_API_KEY=        # USDA MyMarketNews (slaughter, basis, livestock by-product values)
NASS_API_KEY=       # USDA NASS Quick Stats (crop progress & condition)
DATAGOV_API_KEY=    # api.data.gov key, used for USDA FAS export sales
EIA_API_KEY=        # U.S. Energy Information Administration
